@page "/"
@using System.Collections.Immutable
@using Microsoft.AspNetCore.Components.Sections
@using MyLittleContentEngine
@using MyLittleContentEngine.Models
@using MyLittleContentEngine.Services.Content
@inject ContentEngineOptions ContentEngineOptions
@inject IMarkdownContentService<BlogFrontMatter> MarkdownContentService

<PageTitle>Home</PageTitle>
<header class="mb-16">
    <h1 class="text-3xl font-bold mb-2">James Henry</h1>
    <p class="text-lg text-slate-600 leading-snug">
        Software developer focused on logistics and developer tooling. Based in Worcestershire, UK.
        I spend my time modernising legacy monoliths and building opinionated tools for the terminal. I value clean
        paradigms and automated workflows.
    </p>
    <p class="mt-4 text-sm text-slate-500 italic">
        8 years in technical roles: 5y Sysadmin / 3y Dev.<br /> BSc (Hons) 1st Class - Software Engineering.
    </p>
</header>

<div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-20">
    @* Technical Specs *@
    <section>
        <span class="sys-label">System_Specs</span>
        <div class="font-mono text-[11px] space-y-3 mt-4 uppercase">
            <div class="flex justify-between border-dot pb-1">
                <span class="text-slate-400">Stack</span>
                <span>WinForms | Blazor | .NET | Postgres</span>
            </div>
            <div class="flex justify-between border-dot pb-1">
                <span class="text-slate-400">Domain</span>
                <span>LOGISTICS | MANUFACTURING | LEGACY MODERNISATION | AUTOMATIONS</span>
            </div>
            <div class="flex justify-between border-dot pb-1">
                <span class="text-slate-400">Tooling</span>
                <span>CI/CD | DX TOols</span>
            </div>
            <div class="flex justify-between border-dot pb-1">
                <span class="text-slate-400">Status</span>
                <span>Engineering at Logistics Firm</span>
            </div>
        </div>
    </section>

    @* Selected Work *@
    <section>
        <span class="sys-label">Active_Projects</span>
        <div class="mt-4 space-y-4">
            <div>
                <a href="https://github.com/jamesshenry/loom"
                   class="font-bold hover:text-blue-600 underline underline-offset-4 decoration-slate-200">Loom</a>
                <p class="text-xs text-slate-500 mt-1">Opinionated .NET build tool for GitHub/NuGet releases. Dogfooded.
                </p>
            </div>
            <div>
                <a href="https://github.com/jamesshenry/typical"
                   class="font-bold hover:text-blue-600 underline underline-offset-4 decoration-slate-200">Typical</a>
                <p class="text-xs text-slate-500 mt-1">Terminal-based typing game. Monkeytype for the TUI.</p>
            </div>
        </div>
    </section>
</div>

@* Blog Preview Section *@
<section class="mt-32">
    <div class="flex justify-between items-end mb-8">
        <h2 class="text-2xl font-bold">Recent Notes</h2>
        <a href="blog" class="text-xs font-mono text-blue-600 hover:underline">ls -al blog/</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        @foreach (var p in _pages)
        {
            <NavLink href="@p.Url" class="sys-card group">
                <span class="sys-label">@p.FrontMatter.Date.ToShortDateString()</span>
                <h3 class="text-xl group-hover:text-blue-600">@p.FrontMatter.Title</h3>
                <p class="text-sm text-slate-500 mt-2">@p.FrontMatter.Description</p>
            </NavLink>
        }
    </div>
</section>
@code {
    private ImmutableList<MarkdownContentPage<BlogFrontMatter>> _pages = [];

    protected override async Task OnInitializedAsync()
    {
        _pages = await MarkdownContentService.GetAllContentPagesAsync();

        await base.OnInitializedAsync();
    }

}
